{
  "name": "@fluvy/core",
  "version": "1.17.0",
  "private": true,
  "description": "Fluvy's runtime for Home Assistant: vendored types, entity resolution, actions, formatting, i18n, history, the shell, the look engine and the card base class",
  "license": "GPL-3.0-only",
  "author": {
    "name": "acosta290",
    "url": "https://github.com/acosta290"
  },
  "homepage": "https://github.com/acosta290/fluvy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acosta290/fluvy.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/acosta290/fluvy/issues"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./activity": "./src/activity/index.ts",
    "./history": "./src/history/index.ts",
    "./sources": "./src/sources.ts",
    "./locales/en/*.json": "./src/i18n/locales/en/*.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fluvy/tokens": "workspace:*",
    "@fluvy/ui": "workspace:*",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "happy-dom": "^21.0.4",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
